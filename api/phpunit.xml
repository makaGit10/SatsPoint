<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true" : écrase l'environnement du conteneur pour ne JAMAIS tester sur la base de développement. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_URL" value="http://localhost:8120" force="true"/>
        <env name="FRONTEND_URL" value="http://localhost:5190" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5190,localhost,127.0.0.1" force="true"/>
        <env name="SESSION_DOMAIN" value="localhost" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="satspoint_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="DEMO_SEED" value="false" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Valeurs de repli NON secrètes (utilisées seulement si l'environnement ne les fournit pas). -->
        <env name="DB_HOST" value="db"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="DATA_ENCRYPTION_KEY" value="base64:AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="/>
        <env name="GATEWAY_HMAC_SECRET" value="secret-de-test-passerelle-non-utilise-en-production"/>
        <env name="REVERB_APP_KEY" value="cle-reverb-test"/>
        <env name="REVERB_APP_SECRET" value="secret-reverb-test"/>
        <env name="REVERB_APP_ID" value="satspoint-test"/>
    </php>
</phpunit>
