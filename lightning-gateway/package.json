{
  "name": "satspoint-lightning-gateway",
  "version": "1.0.0",
  "description": "Passerelle Lightning de SatsPoint : Nostr Wallet Connect (NIP-47) pour l'API, portefeuille simulé pour la démonstration.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "verifier-connexion": "tsx scripts/verifier-connexion.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@getalby/lightning-tools": "^5.2.1",
    "@getalby/sdk": "^5.1.2",
    "@scure/base": "1.1.1",
    "bolt11": "^1.4.2",
    "fastify": "^5.12.8",
    "light-bolt11-decoder": "^3.2.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
