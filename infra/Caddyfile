{
	# Réglages FrankenPHP facultatifs (image « all » : `num_threads 4` pour tenir dans 512 Mo).
	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
	admin off
	auto_https off
	servers {
		# Mandataires dont les en-têtes X-Forwarded-* sont crus (Render : son répartiteur, réseau privé).
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:private_ranges}
	}
}

# Adresse d'écoute : SERVER_NAME (compose : « :8000 » ; image « all » : « :$PORT », posé par l'entrypoint).

{$SERVER_NAME::8000} {
	# Écoute explicite en IPv4 sur toutes les interfaces : sans cela Caddy n'ouvre qu'un socket IPv6 (« :::port »),
	# que Render ne détecte pas (il exige 0.0.0.0) et que la passerelle ne joint pas sur 127.0.0.1.
	bind {$CADDY_BIND:tcp4/0.0.0.0}
	encode zstd br gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		-X-Powered-By
	}

	# HSTS aussi sur la PWA statique quand TLS est terminé par l'hébergeur (Render) ; l'API pose le sien elle-même.
	@viaHttps header X-Forwarded-Proto https
	header @viaHttps ?Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	# API Laravel, reçus publics, webhooks, fichiers audio
	@backend path /api/* /broadcasting/* /sanctum/* /r/* /webhooks/* /audio/* /internal/* /sante /up
	handle @backend {
		# L'API pose sa propre Permissions-Policy (tout interdit) ; repli si une réponse n'en a pas.
		header ?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		root * /app/api/public
		php_server
	}

	# Temps réel (protocole Pusher) → Reverb (compose : reverb:8080 ; image « all » : 127.0.0.1:8080)
	@ws path /app/*
	handle @ws {
		reverse_proxy {$REVERB_UPSTREAM:reverb:8080}
	}

	# Front (PWA compilée). En développement le front tourne sur Vite (hôte), ce bloc ne sert pas.
	handle {
		# Micro (studio audio : MediaRecorder) et caméra (scan de QR) : même origine seulement, front uniquement.
		header Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
		root * /app/web-dist
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@sw path /sw.js /registerSW.js /manifest.webmanifest
		header @sw Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
