# ---------------------------------------------------------------------------
# SatsPoint — exemple de configuration. Copier en .env et remplir. Aucune valeur secrete ici.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=satspoint
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml   # decommenter pour le mode developpement (code monte, rechargement)
# COMPOSE_PATH_SEPARATOR=:   # obligatoire sous Windows (le separateur par defaut y est « ; »)

APP_NAME=SatsPoint
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8120
FRONTEND_URL=http://localhost:5190
SANCTUM_STATEFUL_DOMAINS=localhost:5190,127.0.0.1:5190,localhost:8120,127.0.0.1:8120
SESSION_DOMAIN=localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Dakar
LOG_LEVEL=debug
# APP_VERSION=0.1.0                        # affichee par /sante et /api/v1/config
# CORS_ORIGINES_SUPPLEMENTAIRES=           # origines CORS en plus de FRONTEND_URL et APP_URL (separees par des virgules)

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=satspoint
DB_USERNAME=postgres
DB_PASSWORD=
# DB_SSLMODE=prefer
# Hebergement (Neon, Render…) : une chaine unique remplace DB_HOST… (ses parametres, dont sslmode, priment)
# DATABASE_URL=postgresql://utilisateur:mot-de-passe@hote/base?sslmode=require

REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=satspoint
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8125
REVERB_PUBLIC_SCHEME=http

DATA_ENCRYPTION_KEY=
GATEWAY_HMAC_SECRET=
LIGHTNING_GATEWAY_URL=http://lightning-gateway:3011
API_INTERNAL_URL=http://api:8000

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=
DEMO_SEED=true
DEMO_PASSWORD=

# Portefeuille Lightning de la boutique de demo (Coinos, NWC). Vide = portefeuille simule.
DEMO_NWC_URI=

# PayTech de la boutique de demo (mode test). Vide = mobile money simule.
PAYTECH_ENV=test
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
# URL publique HTTPS pour les notifications PayTech (tunnel en dev) ; vide = APP_URL
PAYTECH_IPN_BASE_URL=

# Production seulement : autorise le portefeuille simule (mock://) et le bouton « Simuler le paiement »
# ALLOW_MOCK_WALLET=false

# ---------------------------------------------------------------------------
# Image « tout-en-un » (cible Docker `all`, Render) — voir infra/render.yaml. Valeurs par defaut de l'image :
# ---------------------------------------------------------------------------
# SATSPOINT_ROLE=all
# PORT=10000                                 # Caddy ; Reverb 127.0.0.1:8080, passerelle 127.0.0.1:3011
# CACHE_STORE=database                       # pas de Redis : cache, files, sessions en base
# QUEUE_CONNECTION=database
# SESSION_DRIVER=database
# DB_QUEUE_RETRY_AFTER=180
# REVERB_HOST=127.0.0.1
# REVERB_UPSTREAM=127.0.0.1:8080             # cible de Caddy pour /app/* (compose : reverb:8080)
# LIGHTNING_GATEWAY_URL=http://127.0.0.1:3011
# API_INTERNAL_URL=http://127.0.0.1:10000    # rappel de l'API par la passerelle (defaut : http://127.0.0.1:$PORT)
# TRUSTED_PROXIES=*                          # Laravel : pair TCP direct = repartiteur de l'hebergeur
# FRANKENPHP_CONFIG=num_threads 4            # fils PHP (memoire)
# PHP_OPCACHE_MEMORY=64                      # Mo
# APP_URL, FRONTEND_URL, SANCTUM_STATEFUL_DOMAINS, REVERB_PUBLIC_HOST : deduits de RENDER_EXTERNAL_URL si absents

# Developpement local seulement : affiche le code de double authentification a l ecran (ignore hors APP_ENV=local).
DEUX_FA_CODE_LOCAL=false
