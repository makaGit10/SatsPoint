# ---------------------------------------------------------------------------
# SatsPoint — exemple de configuration. Copier en .env et remplir. Aucune valeur secrete ici.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=satspoint
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml   # decommenter pour le mode developpement (code monte, rechargement)

APP_NAME=SatsPoint
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8120
FRONTEND_URL=http://localhost:5190
SANCTUM_STATEFUL_DOMAINS=localhost:5190,127.0.0.1:5190,localhost:8120,127.0.0.1:8120
SESSION_DOMAIN=localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Dakar
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=satspoint
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=satspoint
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8125
REVERB_PUBLIC_SCHEME=http

DATA_ENCRYPTION_KEY=
GATEWAY_HMAC_SECRET=
LIGHTNING_GATEWAY_URL=http://lightning-gateway:3011
API_INTERNAL_URL=http://api:8000

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=
DEMO_SEED=true
DEMO_PASSWORD=

# Portefeuille Lightning de la boutique de demo (Coinos, NWC). Vide = portefeuille simule.
DEMO_NWC_URI=

# PayTech de la boutique de demo (mode test). Vide = mobile money simule.
PAYTECH_ENV=test
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
